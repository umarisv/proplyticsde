# Property Statistics API Server
# Lightweight container - no browser needed

FROM python:3.12-slim-bookworm

WORKDIR /app

# Install minimal dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy only what we need
COPY api_server.py .
COPY requirements-stats.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-stats.txt

# Expose API port
EXPOSE 8502

ENV PORT=8502

# Run the API server
CMD ["python", "api_server.py"]
