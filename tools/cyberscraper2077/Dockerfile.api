# CyberScraper API Server
# Runs FastAPI instead of Streamlit for programmatic access

FROM python:3.12-slim-bookworm

WORKDIR /app

# Install system dependencies including browser dependencies for Playwright/Patchright
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    curl \
    build-essential \
    python3-dev \
    libffi-dev \
    procps \
    # Browser dependencies for Playwright/Patchright
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libcairo2 \
    libpango-1.0-0 \
    libasound2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy local files
COPY . .

# Create and activate a virtual environment
RUN python -m venv venv
ENV PATH="/app/venv/bin:$PATH"

# Install Python dependencies
RUN pip install --no-cache-dir --timeout=120 --retries=3 -r requirements.txt

# Install patchright browser
RUN patchright install chromium

# Expose API port
EXPOSE 8502

# Environment variables
ENV SCRAPER_MODEL=gemini-2.0-flash
ENV PORT=8502

# Run the API server
CMD ["python", "api_server.py"]
