# PropAI Environment Configuration

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
TABLE_PREFIX=propai_

# Supabase (optional, for API access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Scraping
SCRAPER_USER_AGENT=PropAI-Bot/1.0 (Research; +https://proplytics.de/bot)
SCRAPER_DEFAULT_DELAY_SECONDS=1.0
SCRAPER_MAX_REQUESTS_PER_MINUTE=30
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_HEADLESS=true

# Overpass API
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60

# Default center for distance calculations (Koelner Dom)
DEFAULT_CENTER_LAT=50.9413
DEFAULT_CENTER_LON=6.9583

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Server
API_HOST=0.0.0.0
API_PORT=8503

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://dashboard.proplytics.de
